    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "for dirname, _, filenames in os.walk('/content/data'):\n",
        "    print(dirname, len(filenames), \"files\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Nj_47uA6HQwe",
        "outputId": "448a8b4c-30d0-4c2b-c9f8-8668a9a66107"
      },
      "execution_count": 15,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "/content/data 0 files\n",
            "/content/data/train 0 files\n",
            "/content/data/train/dogs 10000 files\n",
            "/content/data/train/cats 10000 files\n",
            "/content/data/test 0 files\n",
            "/content/data/test/dogs 2500 files\n",
            "/content/data/test/cats 2500 files\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from torchvision import transforms\n",
        "\n",
        "train_transforms = transforms.Compose([\n",
        "    transforms.Resize((224, 224)),       # ResNet expects 224x224 images\n",
        "    transforms.RandomHorizontalFlip(),   # slight variation helps prevent overfitting\n",
        "    transforms.ToTensor(),               # convert image to a tensor (numbers)\n",
        "    transforms.Normalize(mean=[0.485, 0.456, 0.406],  # standard ImageNet normalization\n",
        "                          std=[0.229, 0.224, 0.225])\n",
        "])\n",
        "\n",
        "test_transforms = transforms.Compose([\n",
        "    transforms.Resize((224, 224)),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
        "                          std=[0.229, 0.224, 0.225])\n",
        "])"
      ],
      "metadata": {
        "id": "V8mQVhHwHlDV"
      },
      "execution_count": 16,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from torchvision import datasets\n",
        "from torch.utils.data import DataLoader\n",
        "\n",
        "train_data = datasets.ImageFolder('/content/data/train', transform=train_transforms)\n",
        "test_data = datasets.ImageFolder('/content/data/test', transform=test_transforms)\n",
        "\n",
        "train_loader = DataLoader(train_data, batch_size=32, shuffle=True, num_workers=2)\n",
        "test_loader = DataLoader(test_data, batch_size=32, shuffle=False, num_workers=2)\n",
        "\n",
        "print(train_data.classes)         # should print ['cats', 'dogs']\n",
        "print(len(train_data), len(test_data))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2D4BV_jmILZ_",
        "outputId": "f7c17b56-cc04-4afc-abfb-597a6ddcee3e"
      },
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "['cats', 'dogs']\n",
            "20000 5000\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "images, labels = next(iter(train_loader))\n",
        "\n",
        "def denormalize(img):\n",
        "    mean = np.array([0.485, 0.456, 0.406])\n",
        "    std = np.array([0.229, 0.224, 0.225])\n",
        "    img = img.numpy().transpose((1, 2, 0))\n",
        "    img = std * img + mean\n",
        "    return np.clip(img, 0, 1)\n",
        "\n",
        "fig, axes = plt.subplots(1, 4, figsize=(12, 3))\n",
        "for i in range(4):\n",
        "    axes[i].imshow(denormalize(images[i]))\n",
        "    axes[i].set_title(train_data.classes[labels[i]])\n",
        "    axes[i].axis('off')\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 261
        },
        "id": "uFXeUrrgIV01",
        "outputId": "72f1f4fb-f910-4d93-fd55-d06ea2246f8c"
      },
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x300 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "from torchvision import models\n",
        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "\n",
        "# Load ResNet18, pretrained on ImageNet (1.2 million images, 1000 classes)\n",
        "model = models.resnet18(weights='IMAGENET1K_V1')\n",
        "\n",
        "# Freeze all existing layers — we don't want to retrain what it already learned\n",
        "for param in model.parameters():\n",
        "    param.requires_grad = False\n",
        "\n",
        "# Replace the final layer: originally outputs 1000 classes, we need 2 (cat/dog)\n",
        "model.fc = nn.Linear(model.fc.in_features, 2)\n",
        "\n",
        "model = model.to(device)\n",
        "print(model.fc)  # confirm the final layer now outputs 2 classes"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rNiKY8BuIc9a",
        "outputId": "af4b9029-d367-4458-b2b9-d8eec42032c2"
      },
      "execution_count": 19,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Downloading: \"https://download.pytorch.org/models/resnet18-f37072fd.pth\" to /root/.cache/torch/hub/checkpoints/resnet18-f37072fd.pth\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "100%|██████████| 44.7M/44.7M [00:01<00:00, 32.7MB/s]\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Linear(in_features=512, out_features=2, bias=True)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "criterion = nn.CrossEntropyLoss()\n",
        "optimizer = torch.optim.Adam(model.fc.parameters(), lr=0.001)"
      ],
      "metadata": {
        "id": "rjjyxEGtJPJl"
      },
      "execution_count": 20,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "epochs = 3  # one epoch = one full pass through all training data\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    model.train()\n",
        "    running_loss = 0.0\n",
        "    correct = 0\n",
        "    total = 0\n",
        "\n",
        "    for images, labels in train_loader:\n",
        "        images, labels = images.to(device), labels.to(device)\n",
        "\n",
        "        optimizer.zero_grad()          # reset gradients from last batch\n",
        "        outputs = model(images)        # forward pass: get predictions\n",
        "        loss = criterion(outputs, labels)  # calculate how wrong we were\n",
        "        loss.backward()                # backward pass: calculate gradients\n",
        "        optimizer.step()               # update weights\n",
        "\n",
        "        running_loss += loss.item()\n",
        "        _, predicted = torch.max(outputs, 1)\n",
        "        total += labels.size(0)\n",
        "        correct += (predicted == labels).sum().item()\n",
        "\n",
        "    train_acc = 100 * correct / total\n",
        "    print(f\"Epoch {epoch+1}/{epochs} - Loss: {running_loss/len(train_loader):.4f} - Train Accuracy: {train_acc:.2f}%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ay8TQfQfKBiO",
        "outputId": "4643b0e7-7221-4196-b9cd-82ded9304829"
      },
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Epoch 1/3 - Loss: 0.1273 - Train Accuracy: 95.12%\n",
            "Epoch 2/3 - Loss: 0.0848 - Train Accuracy: 96.73%\n",
            "Epoch 3/3 - Loss: 0.0791 - Train Accuracy: 96.94%\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "model.eval()  # switch to evaluation mode (disables things like dropout)\n",
        "correct = 0\n",
        "total = 0\n",
        "\n",
        "with torch.no_grad():  # no need to calculate gradients when just evaluating\n",
        "    for images, labels in test_loader:\n",
        "        images, labels = images.to(device), labels.to(device)\n",
        "        outputs = model(images)\n",
        "        _, predicted = torch.max(outputs, 1)\n",
        "        total += labels.size(0)\n",
        "        correct += (predicted == labels).sum().item()\n",
        "\n",
        "test_acc = 100 * correct / total\n",
        "print(f\"Test Accuracy: {test_acc:.2f}%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9jqt6XzGKJpb",
        "outputId": "40cd076c-eadb-462e-ea52-f85c7efd9de4"
      },
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Test Accuracy: 97.78%\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
