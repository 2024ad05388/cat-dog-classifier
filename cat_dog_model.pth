    {
      "cell_type": "code",
      "source": [
        "import gradio as gr\n",
        "from PIL import Image\n",
        "\n",
        "model.eval()\n",
        "\n",
        "def predict(img):\n",
        "    img = img.convert('RGB')\n",
        "    img_tensor = test_transforms(img).unsqueeze(0).to(device)  # add batch dimension\n",
        "\n",
        "    with torch.no_grad():\n",
        "        output = model(img_tensor)\n",
        "        probs = torch.nn.functional.softmax(output, dim=1)[0]\n",
        "\n",
        "    return {\n",
        "        \"Cat\": float(probs[0]),\n",
        "        \"Dog\": float(probs[1])\n",
        "    }"
      ],
      "metadata": {
        "id": "nvean0WDOUmt"
      },
      "execution_count": 25,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "demo = gr.Interface(\n",
        "    fn=predict,\n",
        "    inputs=gr.Image(type=\"pil\"),\n",
        "    outputs=gr.Label(num_top_classes=2),\n",
        "    title=\"Cat vs Dog Classifier\",\n",
        "    description=\"Upload a photo of a cat or dog and see what the model thinks.\"\n",
        ")\n",
        "\n",
        "demo.launch(debug=True)"
      ],
